{
  "bundleid": "com.aqsnow.alfred.spotify.player",
  "variablesconfig": {
    "SPOTIFY_CLIENT_ID": {
      "src": "variable",
      "scriptenv": true
    },
    "SPOTIFY_CLIENT_SECRET": {
      "src": "variable",
      "scriptenv": true
    },
    "alfred_workflow_cache": {
      "src": "variable",
      "scriptenv": true
    },
    "alfred_workflow_data": {
      "src": "variable",
      "scriptenv": true
    },
    "SPOTIFY_SESSION": {
      "src": "variable",
      "scriptenv": true
    },
    "SPOTIFY_SEEN_ROWS": {
      "src": "variable",
      "scriptenv": true
    },
    "SPOTIFY_SEEN_PREVIEW": {
      "src": "variable",
      "scriptenv": true
    }
  },
  "pulse": {
    "src": "run",
    "args": [
      "poll"
    ],
    "interval": 1,
    "intervalmode": "delay"
  },
  "window": {
    "padding": 12,
    "size": {
      "height": 448
    },
    "root": {
      "id": "root",
      "type": "view",
      "layout": "border",
      "spacing": 10,
      "events": [
        {
          "triggers": "preload",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "init"
            ]
          }
        }
      ],
      "shortcuts": [
        {
          "shortcut": "↑",
          "action": {
            "type": "function",
            "src": "results",
            "args": "selectprevious"
          }
        },
        {
          "shortcut": "↓",
          "action": {
            "type": "function",
            "src": "results",
            "args": "selectnext"
          }
        },
        {
          "shortcut": "↩",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate",
              "{value:results.selected}"
            ]
          }
        },
        {
          "shortcut": "⌘[",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "back"
            ]
          }
        },
        {
          "shortcut": "⌘,",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "configure"
            ]
          }
        },
        {
          "shortcut": "⌘R",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "refresh"
            ]
          }
        },
        {
          "shortcut": "⌃⌘↓",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "playback",
              "toggle"
            ]
          }
        },
        {
          "shortcut": "⌃⌘→",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "playback",
              "next"
            ]
          }
        },
        {
          "shortcut": "⌃⌘←",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "playback",
              "previous"
            ]
          }
        },
        {
          "shortcut": "⌘1",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "0"
            ]
          }
        },
        {
          "shortcut": "⌘2",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "1"
            ]
          }
        },
        {
          "shortcut": "⌘3",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "2"
            ]
          }
        },
        {
          "shortcut": "⌘4",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "3"
            ]
          }
        },
        {
          "shortcut": "⌘5",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "4"
            ]
          }
        },
        {
          "shortcut": "⌘6",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "5"
            ]
          }
        },
        {
          "shortcut": "⌘7",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "6"
            ]
          }
        },
        {
          "shortcut": "⌘8",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "7"
            ]
          }
        },
        {
          "shortcut": "⌘9",
          "action": {
            "type": "script",
            "src": "run",
            "args": [
              "activate-index",
              "8"
            ]
          }
        }
      ],
      "components": [
        {
          "type": "view",
          "layout": "inline",
          "direction": "vertical",
          "spacing": 12,
          "constraints": {
            "region": "top"
          },
          "components": [
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "constraints": {
                "size": {
                  "height": 82
                }
              },
              "components": [
                {
                  "type": "view",
                  "layout": "stack",
                  "constraints": {
                    "region": "left",
                    "size": {
                      "width": 96,
                      "height": 82
                    }
                  },
                  "components": [
                    {
                      "id": "now_art",
                      "type": "imageview",
                      "image": {
                        "type": "symbol",
                        "src": "music.note"
                      },
                      "contenttintcolour": "tertiaryLabelColor",
                      "constraints": {
                        "size": 72,
                        "position": "centre"
                      }
                    }
                  ]
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "spacing": 4,
                  "constraints": {
                    "region": "centre",
                    "position": "centre",
                    "stretch": "horizontal"
                  },
                  "components": [
                    {
                      "id": "now_title",
                      "type": "label",
                      "text": "No track currently selected",
                      "font": {
                        "size": 13
                      }
                    },
                    {
                      "id": "now_detail",
                      "type": "label",
                      "text": "",
                      "colour": "secondaryLabelColor",
                      "font": {
                        "size": 11
                      }
                    }
                  ]
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "horizontal",
                  "spacing": 0,
                  "constraints": {
                    "region": "right",
                    "position": "bottom"
                  },
                  "components": [
                    {
                      "id": "previous",
                      "type": "button",
                      "text": "",
                      "image": {
                        "type": "symbol",
                        "src": "backward.fill"
                      },
                      "bordered": false,
                      "tooltip": "Previous track",
                      "constraints": {
                        "size": {
                          "width": 28,
                          "height": 28
                        }
                      },
                      "accessibility": {
                        "label": "Previous track"
                      },
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": {
                            "type": "script",
                            "src": "run",
                            "args": [
                              "playback",
                              "previous"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "toggle",
                      "type": "button",
                      "text": "",
                      "image": {
                        "type": "symbol",
                        "src": "play.fill"
                      },
                      "bordered": false,
                      "tooltip": "Play or pause",
                      "constraints": {
                        "size": {
                          "width": 28,
                          "height": 28
                        }
                      },
                      "accessibility": {
                        "label": "Play or pause"
                      },
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": {
                            "type": "script",
                            "src": "run",
                            "args": [
                              "playback",
                              "toggle"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "next",
                      "type": "button",
                      "text": "",
                      "image": {
                        "type": "symbol",
                        "src": "forward.fill"
                      },
                      "bordered": false,
                      "tooltip": "Next track",
                      "constraints": {
                        "size": {
                          "width": 28,
                          "height": 28
                        }
                      },
                      "accessibility": {
                        "label": "Next track"
                      },
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": {
                            "type": "script",
                            "src": "run",
                            "args": [
                              "playback",
                              "next"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "search",
              "type": "textfield",
              "text": "",
              "placeholder": "",
              "font": {
                "size": 28
              },
              "bordered": false,
              "background": null,
              "focusring": false,
              "focus": true,
              "accessibility": {
                "label": "Search music"
              },
              "events": [
                {
                  "triggers": "changed",
                  "action": {
                    "type": "script",
                    "src": "run",
                    "args": [
                      "query",
                      "{value:self.text}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "view",
          "layout": "border",
          "spacing": 8,
          "constraints": {
            "region": "centre"
          },
          "components": [
            {
              "id": "results",
              "type": "dataview",
              "placeholder": "No matches",
              "constraints": {
                "region": "centre"
              },
              "select": "",
              "events": [
                {
                  "triggers": "changed",
                  "action": {
                    "type": "script",
                    "src": "run",
                    "args": [
                      "preview",
                      "{value:self.selected}"
                    ]
                  }
                }
              ],
              "cell": {
                "height": 25,
                "init": {
                  "row.background": null,
                  "row_title.colour": "labelColor",
                  "row_key.colour": "secondaryLabelColor",
                  "row_icon.contenttintcolour": "secondaryLabelColor"
                },
                "selected": {
                  "row.background": "alfredSelectedResultBackgroundColor",
                  "row_title.colour": "alfredSelectedResultTextColor",
                  "row_key.colour": "alfredSelectedResultTextColor",
                  "row_icon.contenttintcolour": "alfredSelectedResultTextColor",
                  "row_key.text": "↩"
                },
                "root": {
                  "id": "row",
                  "type": "view",
                  "layout": "border",
                  "spacing": 6,
                  "events": [
                    {
                      "triggers": "doubleclicked",
                      "action": {
                        "type": "script",
                        "src": "run",
                        "args": [
                          "activate",
                          "{data:item}"
                        ]
                      }
                    }
                  ],
                  "components": [
                    {
                      "id": "row_icon",
                      "type": "imageview",
                      "image": {
                        "type": "symbol",
                        "src": "music.note"
                      },
                      "constraints": {
                        "region": "left",
                        "size": 21,
                        "insets": {
                          "left": 6
                        }
                      }
                    },
                    {
                      "id": "row_title",
                      "type": "label",
                      "font": {
                        "size": 16
                      },
                      "constraints": {
                        "region": "centre",
                        "position": "centre",
                        "stretch": "horizontal"
                      }
                    },
                    {
                      "id": "row_key",
                      "type": "label",
                      "font": {
                        "size": 14
                      },
                      "constraints": {
                        "region": "right",
                        "position": "centre",
                        "insets": {
                          "right": 5
                        }
                      }
                    }
                  ]
                }
              },
              "data": {
                "type": "basic",
                "src": []
              }
            },
            {
              "type": "view",
              "layout": "inline",
              "direction": "vertical",
              "spacing": 7,
              "constraints": {
                "region": "right",
                "size": {
                  "width": 230
                },
                "position": "top"
              },
              "components": [
                {
                  "id": "artwork",
                  "type": "imageview",
                  "image": null,
                  "contenttintcolour": "tertiaryLabelColor",
                  "resize": "fit",
                  "constraints": {
                    "size": 230
                  }
                },
                {
                  "id": "preview_title",
                  "type": "label",
                  "text": "",
                  "textalign": "centre",
                  "font": {
                    "size": 13
                  }
                },
                {
                  "id": "preview_detail",
                  "type": "label",
                  "text": "",
                  "textalign": "centre",
                  "linebreak": "wordwrap",
                  "colour": "secondaryLabelColor",
                  "font": {
                    "size": 11
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "view",
          "layout": "border",
          "spacing": 4,
          "constraints": {
            "region": "bottom"
          },
          "components": [
            {
              "id": "status",
              "type": "label",
              "text": "Connect Spotify to browse your playlists",
              "colour": "secondaryLabelColor",
              "font": {
                "size": 10
              },
              "constraints": {
                "region": "centre"
              }
            },
            {
              "id": "reconnect",
              "type": "button",
              "text": "Connect",
              "hidden": true,
              "font": {
                "size": 11
              },
              "constraints": {
                "region": "right"
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "run",
                    "args": [
                      "connect"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
