#!/bin/sh
set -eu
task_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONPATH="$task_dir/lib:$task_dir/src${PYTHONPATH:+:$PYTHONPATH}"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
if command -v python3 >/dev/null 2>&1; then
    exec python3 -m alfred_spotify "$@"
fi
printf '%s\n' '{"variables":{"status_text":"Python 3.14 or newer is required. Install it with: brew install python"},"update":{"ids":{"status":{"text":"{var:status_text}"},"now_title":{"text":"Install Python 3.14 or newer"}}}}'
